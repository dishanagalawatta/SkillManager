# SkillManager — .gitignore
# Canonical cleanup rules: docs/HOUSEKEEPING.md
# Architectural decisions: docs/adr/ADR-0016 (.opencode), ADR-0018 (standardization)

# ─── IDE / Editor ────────────────────────────────────────────────
.vscode/settings.json
*.code-workspace
.idea/
*.iml

# ─── OS / Desktop ────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
*~

# ─── Python ──────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
pip-wheel-metadata/
build/
dist/
.mypy_cache/
.hypothesis/
.tox/
.nox/
.venv/
venv/
node_modules/
# Static analysis tool caches
.pyre/
.dmypy.json
*.py,cover
cython_debug/

# ─── Testing / Linting ──────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
coverage.json
htmlcov/

# ─── Qt / PySide6 ───────────────────────────────────────────────
.qmlcache/
.qmltypes/
*.qmlc
*.jsc

# ─── Runtime State (regenerable) ─────────────────────────────────
# Per ADR-0018: data/ is user runtime; app recreates on first run.
data/
cache_dump.txt
*.log

# ─── Deprecated Artifacts (ADR-0010) ─────────────────────────────
tuf_keys/
tuf_repo/
.tufup-repo-config

# ─── Agent / Local Tooling ──────────────────────────────────────
# Per ADR-0016: .opencode/ is local agent config, never committed.
# Per ADR-0022: all local agent/IDE index dirs are excluded.
.opencode/
.omo/
.jules/
.codegraph/
.icons_temp/
.playwright-mcp/

# MCP screenshot captures (regenerable; must never be committed)
.agents/screenshots/

# ─── Build / Runtime Diagnostic Artifacts ────────────────────────
# Large runtime diagnostic logs (also covered by *.log wildcard above)
shutdown_diag.log

# ─── Environment / Secrets (never commit) ─────────────────────
# .env* contains live API tokens (PostHog, Sentry, etc.)
# .env.example is the canonical template (see ADR-0023).
.env
.env.*
!.env.example
!environments/.env.*.example

# Windows code-signing material (PKCS#12: certificate + private key).
# Since 2023 no publicly trusted CA issues an exportable code-signing key, so
# signing runs through a cloud signing service and no bundle belongs in the tree.
# packaging/windows/certs/code-signing.pfx was removed from the working tree and
# from the repository history on 2026-10-19 — see docs/SECURITY.md.
*.pfx
*.p12

# ─── Local TODO Screenshots ─────────────────────────────────────
# Pasted reference images for notebook-style TODO items. Local only: an
# untracked file here made `scripts/release.py` abort on a dirty tree.
image/TODO/

# ─── Local agent helper ─────────────────────────────────────────
# scripts/agent-sudo reads a machine-specific keyring entry, so it is local
# to this checkout and must never be committed.
scripts/agent-sudo
