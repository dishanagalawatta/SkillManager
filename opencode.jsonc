{
  "$schema": "https://opencode.ai/config.json",
  // Machine-local policy, auto-loaded every session. AGENTS.md is the
  // committed, portable policy; AGENTS.local.md is gitignored and records a
  // permission granted on one machine (privileged installs). Absent in a
  // fresh clone — the loader skips missing instruction files, so that is
  // harmless.
  "instructions": ["AGENTS.local.md"],
  "mcp": {
    "skillmanager": {
      "type": "local",
      // --mcp = headless server (offscreen Qt, all 40 tools, no GUI needed).
      // --mcp-light only exposes 7 tools and needs a running GUI over IPC.
      "command": ["bash", "scripts/mcp_launcher.sh", "--mcp"],
      "enabled": true
    },
    "servers": {
      "posthog": {
        "type": "remote",
        "url": "https://mcp.posthog.com/mcp?mode=cli&readonly=true"
      }
    }
  },
  // LSP servers. Disabled by default in opencode — must be enabled explicitly.
  // All entries here are fully-explicit; no built-in auto-load.
  "lsp": {
    // pyright (Python language server).
    // Uses the globally installed pyright-langserver on PATH.
    // Reads .pyrightconfig.json automatically for type-check mode,
    // includes/excludes, venv path, and Python 3.12 platform.
    "pyright": {
      "command": ["pyright-langserver", "--stdio"],
      "extensions": [".py", ".pyi"]
    },

    // qmlls (Qt official QML language server).
    // Shipped with PySide6 (already a project dep); no extra install needed.
    // Path points into the project venv; venv is gitignored so path is stable locally.
    "qmlls": {
      "command": [".venv/Lib/site-packages/PySide6/qmlls.exe", "--stdio"],
      "extensions": [".qml"]
    }
  }
}
