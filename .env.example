# =============================================================================
# SkillManager — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
#
# Tier-specific defaults:
#   environments/.env.dev.example     — development (default)
#   environments/.env.staging.example — staging
#   environments/.env.prod.example    — production
#
# Full variable reference: docs/ENVIRONMENT.md
# Environment setup guide: environments/README.md
# =============================================================================

# ---- Qt / QML ---------------------------------------------------------------
# QT_QUICK_CONTROLS_STYLE=Basic    # UI control style (Basic, Material, Universal)
# QML_DISABLE_DISK_CACHE=1         # Set to 1 for dev/test; omit for prod
# QT_QPA_PLATFORM=offscreen        # Use for headless/CI environments

# ---- Application ------------------------------------------------------------
# SKILL_MANAGER_TESTING=1          # Test mode: disables telemetry and polling
# SKILL_MANAGER_SKIP_INITIAL_LOAD=1 # Skip initial skill discovery on startup
# SKILL_MANAGER_DATA_DIR=          # Override default data directory (empty = default)
# SKILL_MANAGER_LOG_LEVEL=INFO     # Log verbosity: DEBUG | INFO | WARNING | ERROR

# ---- Telemetry --------------------------------------------------------------
# PostHog: anonymous product analytics (opt-in; disabled in dev/test by default)
POSTHOG_PROJECT_TOKEN=<your_posthog_project_token>
POSTHOG_HOST=https://us.i.posthog.com

# Sentry: crash/error tracking (optional; leave DSN empty to disable)
SENTRY_DSN=<your_sentry_dsn>
